# Managed by the `shell` Ansible role.
# ~/.profile: executed by the command interpreter for login shells.

# if running bash, include .bashrc
if [ -n "$BASH_VERSION" ]; then
    if [ -f "$HOME/.bashrc" ]; then
        . "$HOME/.bashrc"
    fi
fi

# PATH: user/go/local/cargo/node bins if present
[ -d "$HOME/bin" ] && PATH="$HOME/bin:$PATH"
[ -d "$HOME/go/bin" ] && PATH="$HOME/go/bin:$PATH"
[ -d "$HOME/.local/bin" ] && PATH="$HOME/.local/bin:$PATH"
[ -d "/usr/local/go/bin" ] && PATH="/usr/local/go/bin:$PATH"
[ -d "$HOME/node_modules/.bin" ] && PATH="$HOME/node_modules/.bin:$PATH"
export PATH

# Toolchains (sourced only if present)
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"   # uv
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"           # rust/cargo
