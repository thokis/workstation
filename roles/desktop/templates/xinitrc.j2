#!/bin/bash
# Managed by the `desktop` Ansible role.

xrdb -merge ~/.Xresources
xsetroot -cursor_name left_ptr
setxkbmap {{ keyboard_layout }}

export XDG_CURRENT_DESKTOP=GTK
# Use the systemd --user session bus (already has gnome-keyring, xdg-desktop-portal, etc.)
# instead of an isolated dbus-run-session bus, so those services resolve instantly.
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
# SSH agent is gcr-ssh-agent (gnome-keyring no longer runs its own ssh component),
# whose socket lives at gcr/ssh — NOT the legacy keyring/ssh path.
systemctl --user start gcr-ssh-agent.socket 2>/dev/null
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gcr/ssh"

# Make the X session env visible to dbus-activated and systemd --user services.
dbus-update-activation-environment DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP SSH_AUTH_SOCK 2>/dev/null
systemctl --user import-environment DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP SSH_AUTH_SOCK 2>/dev/null

feh --no-fehbg --bg-fill '{{ desktop_wallpaper }}' &
slstatus &
picom --config "$HOME/.config/picom.conf" &
idle-manager &
nm-applet &

# --- screen locking (xsecurelock) ---
# `lockscreen` snapshots+blurs the screen and sets all XSECURELOCK_* appearance
# options itself, then execs xsecurelock. Lock before suspend (any trigger) and
# on `loginctl lock-session`.
xss-lock -- "$HOME/.local/bin/lockscreen" &

while dwm; do :; done
