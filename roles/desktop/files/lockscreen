#!/bin/sh
# Lock the screen with xsecurelock: plain black background + password prompt.
# Used both by the dwm keybind and by xss-lock (suspend / lock-session).
set -eu

# --- xsecurelock appearance (authoritative here, so it applies regardless of
# --- whatever env the running X session was started with) ---
export XSECURELOCK_SHOW_DATETIME=0
export XSECURELOCK_SHOW_USERNAME=0           # don't show the username
export XSECURELOCK_SHOW_HOSTNAME=0
export XSECURELOCK_SHOW_KEYBOARD_LAYOUT=0    # don't reveal the keyboard layout
export XSECURELOCK_DATETIME_FORMAT="%a %Y-%m-%d  %H:%M"
export XSECURELOCK_PASSWORD_PROMPT=asterisks
export XSECURELOCK_AUTH_TIMEOUT=30
export XSECURELOCK_BLANK_TIMEOUT=10          # blank after 10s locked
export XSECURELOCK_BLANK_DPMS_STATE=off      # power the panel off when blanked

exec xsecurelock
