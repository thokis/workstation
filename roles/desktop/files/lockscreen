#!/bin/sh
# Lock the screen with xsecurelock, showing a blurred snapshot of the current
# screen as the background. Capture happens here, BEFORE xsecurelock covers the
# screen; saver_blur then renders the result inside the lock window.
# Used both by the dwm keybind and by xss-lock (suspend / lock-session).
set -eu

# --- xsecurelock appearance (authoritative here, so it applies regardless of
# --- whatever env the running X session was started with) ---
export XSECURELOCK_SHOW_DATETIME=0
export XSECURELOCK_SHOW_USERNAME=0           # don't show the username
export XSECURELOCK_SHOW_HOSTNAME=0
export XSECURELOCK_SHOW_KEYBOARD_LAYOUT=0    # don't reveal the keyboard layout
export XSECURELOCK_DATETIME_FORMAT="%a %Y-%m-%d  %H:%M"
export XSECURELOCK_PASSWORD_PROMPT=asterisks
export XSECURELOCK_AUTH_TIMEOUT=30
export XSECURELOCK_BLANK_TIMEOUT=10          # blank after 10s locked
export XSECURELOCK_BLANK_DPMS_STATE=off      # power the panel off when blanked

shot=/tmp/xsecurelock-shot.png
bg=/tmp/xsecurelock-bg.png

# Snapshot + blur. Downscale -> blur -> upscale is fast and looks smooth;
# -modulate 70 dims it ~30% so the password prompt stays readable.
if scrot -o -z "$shot" 2>/dev/null; then
	convert "$shot" -scale 20% -blur 0x3 -resize 500% -modulate 70 "$bg" 2>/dev/null || rm -f "$bg"
	rm -f "$shot"
	[ -f "$bg" ] && chmod 600 "$bg" 2>/dev/null || true
fi

export XSECURELOCK_SAVER="$HOME/.local/bin/saver_blur"
export XSECURELOCK_BG_IMAGE="$bg"
exec xsecurelock
