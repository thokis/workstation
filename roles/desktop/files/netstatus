#!/bin/sh
out=""

# WiFi (U+F1EB)
wip=$(ip -4 -o addr show dev wlp1s0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
if [ -n "$wip" ]; then
	ssid=$(iw dev wlp1s0 link 2>/dev/null | awk '/SSID:/{print $2}')
	printf -v _ 2>/dev/null  # test bash
	out="   ${wip} (${ssid})"
fi

# Ethernet — first en* interface with an IPv4 address (U+F6FF)
for dev in $(ls /sys/class/net/ | grep '^en'); do
	eip=$(ip -4 -o addr show dev "$dev" 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
	if [ -n "$eip" ]; then
		[ -n "$out" ] && out="${out} "
		out="${out}|   ${eip}"
		break
	fi
done

[ -z "$out" ] && out="no net"
printf '%s' "$out"
